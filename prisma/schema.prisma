// Prisma schema for Lottery POS System
// Database: SQLite (local offline)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Juegos de lotería disponibles
model Game {
  id          String   @id @default(cuid())
  name        String   @unique
  isActive    Boolean  @default(true)
  digitCount  Int      @default(2) // 1, 2, o 3 dígitos
  multiplier  Float    @default(70) // Multiplicador de premio
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedules   DrawSchedule[]
  ticketItems TicketItem[]
  results     Result[]

  @@index([isActive])
}

// Horarios de sorteo por juego
model DrawSchedule {
  id        String   @id @default(cuid())
  gameId    String
  name      String   // "Mañana", "Tarde", "Noche"
  time      String   // "10:00", "14:00", "21:00"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game    Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  results Result[]

  @@unique([gameId, time])
  @@index([gameId])
}

// Tickets de venta
model Ticket {
  id           String    @id @default(cuid())
  ticketNumber String    @unique // Número legible: TKT-20240101-0001
  client       String?   // Nombre del cliente
  totalAmount  Float
  status       String    @default("active") // active, cancelled, paid
  cancelReason String?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items   TicketItem[]
  winners Winner[]

  @@index([status])
  @@index([createdAt])
}

// Items de cada ticket (jugadas individuales)
model TicketItem {
  id        String   @id @default(cuid())
  ticketId  String
  gameId    String
  number    String   // El número apostado
  amount    Float    // Monto apostado
  schedule  String   // Horario del sorteo
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  game   Game   @relation(fields: [gameId], references: [id])

  @@index([ticketId])
  @@index([gameId])
  @@index([number])
}

// Resultados de sorteos
model Result {
  id             String   @id @default(cuid())
  gameId         String
  scheduleId     String
  winningNumber  String
  drawDate       DateTime @default(now())
  isProcessed    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  game     Game         @relation(fields: [gameId], references: [id])
  schedule DrawSchedule @relation(fields: [scheduleId], references: [id])
  winners  Winner[]

  @@unique([gameId, scheduleId, drawDate])
  @@index([drawDate])
  @@index([gameId])
}

// Boletos ganadores
model Winner {
  id          String    @id @default(cuid())
  ticketId    String
  resultId    String
  prizeAmount Float
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id])
  result Result @relation(fields: [resultId], references: [id])

  @@index([ticketId])
  @@index([resultId])
  @@index([isPaid])
}

// Sesiones de caja
model CashSession {
  id              String    @id @default(cuid())
  openingAmount   Float
  closingAmount   Float?
  salesTotal      Float     @default(0)
  prizesTotal     Float     @default(0)
  status          String    @default("open") // open, closed
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  movements CashMovement[]

  @@index([status])
  @@index([openedAt])
}

// Movimientos de caja
model CashMovement {
  id            String   @id @default(cuid())
  cashSessionId String
  type          String   // income, expense, sale, prize_payment
  amount        Float
  description   String
  createdAt     DateTime @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([cashSessionId])
  @@index([type])
}

// Configuraciones del sistema
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Log de cancelaciones
model CancellationLog {
  id           String   @id @default(cuid())
  ticketId     String
  ticketNumber String
  totalAmount  Float
  reason       String
  itemsJson    String   // JSON de los items cancelados
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
